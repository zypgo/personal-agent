# `pa init` creates ~/.personal-agent/.env for you; this file documents what it can contain.
# Only $PA_HOME/.env is ever read (never a .env in the directory you run `pa` from).
# For development, use a throwaway home:  PA_HOME=./.pa-home uv run pa init

# --- Required: one general OpenAI API key ---------------------------------
OPENAI_API_KEY=

# --- Optional: point at an OpenAI-compatible endpoint ----------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# --- Optional: where the agent keeps its state (default: ~/.personal-agent) -
# PA_HOME=~/.personal-agent

# --- Optional: channels -----------------------------------------------------
# Telegram bot token from @BotFather (lets you talk to the agent from your phone)
# TELEGRAM_BOT_TOKEN=
# DingTalk application robot: enable Stream mode and private chat in the developer console.
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=

# --- Optional: secrets the agent can use without seeing them ----------------
# Referenced from config.toml as {{secret:NAME}} and only injected for allowed hosts.
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=

# --- Optional: tracing --------------------------------------------------------
# PA_TRACING=off          # off | local
