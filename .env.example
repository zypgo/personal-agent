# Copy to ~/.personal-agent/.env (or to ./.env while developing) and fill in.
# This file is read by `pa`; it is git-ignored. NEVER paste keys into chat or commit them.

# --- Required: one general OpenAI API key ---------------------------------
OPENAI_API_KEY=

# --- Optional: point at an OpenAI-compatible endpoint ----------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# --- Optional: where the agent keeps its state (default: ~/.personal-agent) -
# PA_HOME=~/.personal-agent

# --- Optional: channels -----------------------------------------------------
# Telegram bot token from @BotFather (lets you talk to the agent from your phone)
# TELEGRAM_BOT_TOKEN=

# --- Optional: secrets the agent may *use* but never *see* -------------------
# Referenced from config.toml as {{secret:NAME}} and only injected for allowed hosts.
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=

# --- Privacy: both are OFF unless you turn them on ---------------------------
# PA_TRACING=off          # off | local   (OpenAI-hosted tracing is never enabled)
