# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
auth.json

# --- local agent state (personal data!) ---
.pa-home/
*.db
*.db-wal
*.db-shm
*.sqlite3

# --- third-party reference clones (read-only study material; see references/README.md) ---
/references/*
!/references/README.md
!/references/SOURCES.lock

# --- python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- node (web tooling, if any) ---
node_modules/

# --- editors / os ---
.DS_Store
.idea/
.vscode/
